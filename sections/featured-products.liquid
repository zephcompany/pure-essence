{% assign featured_handles = 'paradox,good-body-splash,only-bleu,pacific-body-splash,good,magination-body-splash,pacific,paradox-body-splash,magination,swin-body-splash' | split: ',' %}
<section class="section products-section" id="essencia">
  <div class="page-width">
    <div class="section-head section-head--rich">
      <div>
        <div class="eyebrow">PURE ESSENCE · MAIS VENDIDOS</div>
        <h2>Os favoritos da <span class="text-accent">Pure.</span></h2>
        <p class="section-intro">Perfumes e Body Splashes reunidos em uma seleção para descobrir, combinar e criar seu ritual de fragrância.</p>
      </div>
      <a class="section-link" href="{{ routes.all_products_collection_url }}">
        <span>Ver todos</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="pe-category-tabs" aria-label="Categorias">
      <a href="/collections/perfumes">Perfumes</a>
      <a href="/collections/body-splash">Body Splash</a>
    </div>

    <div class="product-grid product-grid--home">
      {% assign shown = 0 %}
      {% for featured_handle in featured_handles %}
        {% assign product_item = all_products[featured_handle] %}
        {% if product_item != blank and product_item.tags contains 'hidden-combo' == false %}
          {% render 'product-card', product: product_item %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

    {% if shown == 0 %}
      <div class="empty-state">Os produtos ainda não estão disponíveis no canal Loja virtual da Shopify.</div>
    {% endif %}
  </div>
</section>

<style>
  .pe-category-tabs{display:flex;gap:8px;margin:-8px 0 28px;flex-wrap:wrap}
  .pe-category-tabs a{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:0 16px;border:1px solid rgba(17,17,17,.14);background:rgba(255,255,255,.45);font-size:9px;letter-spacing:.1em;text-transform:uppercase;transition:.2s}
  .pe-category-tabs a:hover{border-color:var(--pe-accent);color:var(--pe-accent)}
  @media(max-width:640px){.pe-category-tabs{margin:-2px 0 22px}.pe-category-tabs a{flex:1;min-width:0;padding:0 10px}}
</style>

{% schema %}
{
  "name":"Mais vendidos",
  "settings":[],
  "presets":[{"name":"Mais vendidos"}]
}
{% endschema %}