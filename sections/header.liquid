<div class="announcement">
  <div class="announcement-inner">
    <span class="announcement-dot"></span>
    <span>{{ section.settings.announcement }}</span>
  </div>
</div>
<header class="site-header">
  <div class="page-width header-inner">
    <div class="header-left">
      <button class="mobile-toggle icon-button" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
      <nav class="header-nav" aria-label="Navegação principal">
        <a href="/collections/perfumes" data-close-menu>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6v3.5l2 2V20H7V8.5l2-2V3Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 11h6" stroke="currentColor" stroke-width="1.5"/></svg>
          <span>Perfumes</span>
        </a>
        <a href="{{ routes.root_url }}#essencia" data-close-menu>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1.3 3.1 3.8 5.6 7 7-3.2 1.4-5.7 3.9-7 7-1.3-3.1-3.8-5.6-7-7 3.2-1.4 5.7-3.9 7-7Z" fill="none" stroke="currentColor" stroke-width="1.45"/></svg>
          <span>Nossa essência</span>
        </a>
        <a href="{{ routes.root_url }}#dubai-brasil" data-close-menu>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <span>Dubai → Brasil</span>
        </a>
      </nav>
    </div>

    <a class="brand" href="{{ routes.root_url }}" aria-label="Pure Essence & Co">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 520 | image_tag: loading: 'eager', alt: 'Pure Essence & Co' }}
      {% else %}
        <img class="brand-logo brand-logo--full" src="{{ 'pure-essence-logo.webp' | asset_url }}" alt="Pure Essence & Co" width="360" height="255" loading="eager">
        <img class="brand-logo brand-logo--mark" src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="Pure Essence & Co" width="180" height="201" loading="eager">
      {% endif %}
    </a>

    <div class="header-actions">
      <a class="header-action search-link" href="{{ routes.search_url }}" aria-label="Buscar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <span>Buscar</span>
      </a>
      <a class="header-action cart-link" href="{{ routes.cart_url }}" aria-label="Sacola com {{ cart.item_count }} itens">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5h11l1 11h-13l1-11Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 9V7a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        <span>Sacola</span>
        <b class="cart-count">{{ cart.item_count }}</b>
      </a>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {"type":"text","id":"announcement","label":"Faixa superior","default":"DE DUBAI PARA O BRASIL · PERFUMES 100 ML · ENVIO PARA TODO O BRASIL"},
    {"type":"image_picker","id":"logo","label":"Substituir logo padrão"}
  ]
}
{% endschema %}