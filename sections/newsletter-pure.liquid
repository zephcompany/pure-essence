<section class="newsletter-section">
  <div class="page-width newsletter-shell">
    <div class="newsletter-copy">
      <div class="newsletter-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4V6Z" fill="none" stroke="currentColor" stroke-width="1.45"/><path d="m5 7 7 6 7-6" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading_before }} <span class="text-accent">{{ section.settings.heading_highlight }}</span></h2>
        <p>{{ section.settings.text }}</p>
      </div>
    </div>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Seu e-mail</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="seuemail@exemplo.com" required>
      <button type="submit" aria-label="Cadastrar e-mail">
        <span>Quero receber</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      {% if form.posted_successfully? %}<p class="newsletter-message">Cadastro realizado. Bem-vindo ao universo Pure Essence.</p>{% endif %}
      {% if form.errors %}<div class="newsletter-message">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name":"Newsletter Pure Essence",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Texto pequeno","default":"PURE ESSENCE CLUB"},
    {"type":"text","id":"heading_before","label":"Título antes","default":"Entre para o nosso"},
    {"type":"text","id":"heading_highlight","label":"Destaque","default":"universo."},
    {"type":"textarea","id":"text","label":"Texto","default":"Receba novidades, lançamentos e conteúdos sobre fragrâncias diretamente no seu e-mail."}
  ],
  "presets":[{"name":"Newsletter Pure Essence"}]
}
{% endschema %}