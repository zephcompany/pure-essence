<section class="cart-page"><div class="page-width"><h1>Sua sacola</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a><div><div class="eyebrow">{{ item.product.vendor }}</div><h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3><div>{{ item.final_price | money }}</div><label for="updates_{{ item.key }}" class="eyebrow" style="display:block;margin:14px 0 6px">Quantidade</label><input id="updates_{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}<div class="cart-footer"><div class="cart-summary"><div class="cart-summary__total"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div><button class="button button--outline" type="submit" name="update" style="width:100%;margin-bottom:8px">Atualizar sacola</button><button class="button" type="submit" name="checkout">Finalizar compra</button></div></div></form>{% else %}<div class="empty-state">Sua sacola está vazia. <a href="{{ routes.all_products_collection_url }}"><u>Conheça as fragrâncias</u></a>.</div>{% endif %}</div></section>
{% schema %}{"name":"Carrinho principal","settings":[]}{% endschema %}