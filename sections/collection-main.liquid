<section>
  <div class="page-width collection-hero">
    <div class="eyebrow">PURE ESSENCE & CO</div>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
  </div>

  <div class="page-width section" style="padding-top:24px">
    <div class="product-grid">
      {% assign shown = 0 %}

      {% if collection.products_count > 0 %}
        {% paginate collection.products by 24 %}
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endfor %}
          {{ paginate | default_pagination }}
        {% endpaginate %}
      {% else %}
        {% for product in collections['all'].products %}
          {% if product.type == 'Perfume' or product.vendor == 'Pure Essence & Co' %}
            {% render 'product-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    {% if shown == 0 %}
      <div class="empty-state">Os perfumes ainda não estão publicados no canal Loja virtual da Shopify.</div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Coleção principal","settings":[]}{% endschema %}