{% assign is_body_splash_view = false %}
{% if current_tags contains 'Body Splash' or collection.handle == 'body-splash' %}{% assign is_body_splash_view = true %}{% endif %}
{% assign is_perfume_view = false %}
{% if collection.handle == 'perfumes' %}{% assign is_perfume_view = true %}{% endif %}

<section>
  <div class="page-width collection-hero">
    <div class="eyebrow">PURE ESSENCE & CO</div>
    <h1>{% if is_body_splash_view %}Body Splash{% elsif is_perfume_view %}Perfumes{% else %}{{ collection.title }}{% endif %}</h1>
    {% if is_body_splash_view %}
      <p>A mesma identidade olfativa das fragrâncias Pure Essence em uma versão mais leve para acompanhar e reaplicar ao longo do dia.</p>
    {% elsif is_perfume_view %}
      {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
    {% else %}
      <p>Perfumes e Body Splashes Pure Essence & Co.</p>
    {% endif %}
  </div>

  <div class="page-width section" style="padding-top:24px">
    <div class="product-grid">
      {% assign shown = 0 %}

      {% if collection.products_count > 0 %}
        {% paginate collection.products by 24 %}
          {% for product in collection.products %}
            {% unless product.tags contains 'hidden-combo' %}
              {% if is_body_splash_view %}
                {% if product.type == 'Body Splash' or product.tags contains 'Body Splash' %}
                  {% render 'product-card', product: product %}
                  {% assign shown = shown | plus: 1 %}
                {% endif %}
              {% elsif is_perfume_view %}
                {% if product.type == 'Perfume' %}
                  {% render 'product-card', product: product %}
                  {% assign shown = shown | plus: 1 %}
                {% endif %}
              {% else %}
                {% if product.type == 'Perfume' or product.type == 'Body Splash' %}
                  {% render 'product-card', product: product %}
                  {% assign shown = shown | plus: 1 %}
                {% endif %}
              {% endif %}
            {% endunless %}
          {% endfor %}
          {{ paginate | default_pagination }}
        {% endpaginate %}
      {% else %}
        {% for product in collections['all'].products %}
          {% unless product.tags contains 'hidden-combo' %}
            {% if is_body_splash_view %}
              {% if product.type == 'Body Splash' or product.tags contains 'Body Splash' %}
                {% render 'product-card', product: product %}
                {% assign shown = shown | plus: 1 %}
              {% endif %}
            {% elsif is_perfume_view %}
              {% if product.type == 'Perfume' %}
                {% render 'product-card', product: product %}
                {% assign shown = shown | plus: 1 %}
              {% endif %}
            {% else %}
              {% if product.type == 'Perfume' or product.type == 'Body Splash' %}
                {% render 'product-card', product: product %}
                {% assign shown = shown | plus: 1 %}
              {% endif %}
            {% endif %}
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>

    {% if shown == 0 %}
      <div class="empty-state">Nenhum produto disponível no momento.</div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Coleção principal","settings":[]}{% endschema %}