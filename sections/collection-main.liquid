<section><div class="page-width collection-hero"><div class="eyebrow">PURE ESSENCE & CO</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}</div><div class="page-width section" style="padding-top:24px">{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state">Nenhum perfume disponível nesta coleção.</div>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</div></section>
{% schema %}{"name":"Coleção principal","settings":[]}{% endschema %}