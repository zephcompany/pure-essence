<section class="section pillars-section">
  <div class="page-width">
    <div class="pillars-heading">
      <div>
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading_before }} <span class="text-accent">{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_after }}</h2>
      </div>
      <p>{{ section.settings.intro }}</p>
    </div>

    <div class="pillars-grid">
      <article class="pillar-card">
        <div class="pillar-number">01</div>
        <div class="pillar-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z" fill="none" stroke="currentColor" stroke-width="1.45"/><circle cx="12" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.45"/></svg>
        </div>
        <h3>{{ section.settings.card_1_title }}</h3>
        <p>{{ section.settings.card_1_text }}</p>
      </article>

      <article class="pillar-card pillar-card--accent">
        <div class="pillar-number">02</div>
        <div class="pillar-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1.3 3.1 3.8 5.6 7 7-3.2 1.4-5.7 3.9-7 7-1.3-3.1-3.8-5.6-7-7 3.2-1.4 5.7-3.9 7-7Z" fill="none" stroke="currentColor" stroke-width="1.45"/><path d="M18.5 3.5c.5 1.2 1.5 2.2 2.7 2.7-1.2.5-2.2 1.5-2.7 2.7-.5-1.2-1.5-2.2-2.7-2.7 1.2-.5 2.2-1.5 2.7-2.7Z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        </div>
        <h3>{{ section.settings.card_2_title }}</h3>
        <p>{{ section.settings.card_2_text }}</p>
      </article>

      <article class="pillar-card pillar-card--mark">
        <img src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="" class="pillar-watermark" width="320" height="356" loading="lazy">
        <div class="pillar-number">03</div>
        <div class="pillar-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6v3.5l2 2V20H7V8.5l2-2V3Z" fill="none" stroke="currentColor" stroke-width="1.45"/><path d="M9 11h6M9 15h6" stroke="currentColor" stroke-width="1.45"/></svg>
        </div>
        <h3>{{ section.settings.card_3_title }}</h3>
        <p>{{ section.settings.card_3_text }}</p>
      </article>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Pilares da marca",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Texto pequeno","default":"O DNA PURE ESSENCE"},
    {"type":"text","id":"heading_before","label":"Título antes","default":"Luxo que começa na"},
    {"type":"text","id":"heading_highlight","label":"Destaque","default":"origem"},
    {"type":"text","id":"heading_after","label":"Título depois","default":"e permanece na memória."},
    {"type":"textarea","id":"intro","label":"Introdução","default":"Inspirada pela perfumaria de Dubai, a Pure Essence & Co transforma sofisticação em fragrâncias feitas para o dia a dia brasileiro."},
    {"type":"text","id":"card_1_title","label":"Card 1 título","default":"Nascida em Dubai"},
    {"type":"textarea","id":"card_1_text","label":"Card 1 texto","default":"Uma marca criada sob a influência de um dos maiores centros de luxo e perfumaria do mundo."},
    {"type":"text","id":"card_2_title","label":"Card 2 título","default":"Essência sofisticada"},
    {"type":"textarea","id":"card_2_text","label":"Card 2 texto","default":"Perfis olfativos pensados para despertar sensações, presença e personalidade."},
    {"type":"text","id":"card_3_title","label":"Card 3 título","default":"100 ml de presença"},
    {"type":"textarea","id":"card_3_text","label":"Card 3 texto","default":"Frascos marcantes, identidade premium e uma experiência criada para permanecer."}
  ],
  "presets":[{"name":"Pilares da marca"}]
}
{% endschema %}