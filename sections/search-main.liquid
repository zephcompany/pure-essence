<section class="search-page"><div class="page-width"><h1>Buscar</h1><form action="{{ routes.search_url }}" method="get" class="search-form" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Buscar fragrância"><input type="hidden" name="type" value="product"><button class="button" type="submit">Buscar</button></form>{% if search.performed %}{% paginate search.results by 24 %}<div class="product-grid">{% assign visible_results = 0 %}{% for item in search.results %}{% if item.object_type == 'product' and item.type != 'Combo' %}{% render 'product-card', product: item %}{% assign visible_results = visible_results | plus: 1 %}{% endif %}{% endfor %}{% if visible_results == 0 %}<div class="empty-state">Nenhum produto encontrado.</div>{% endif %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</div></section>
