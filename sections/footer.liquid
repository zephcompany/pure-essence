<footer class="footer">
  <div class="page-width">
    <div class="footer-grid">
      <div>
        <img class="footer-logo" src="{{ 'pure-essence-logo.webp' | asset_url }}" alt="Pure Essence & Co" width="360" height="255" loading="lazy">
        <p>Fragrâncias sofisticadas que nasceram em Dubai e chegam ao Brasil para transformar sensações em memórias.</p>
      </div>
      <div>
        <h3>Navegação</h3>
        <div class="footer-links">
          <a href="{{ routes.all_products_collection_url }}">Todos os perfumes</a>
          <a href="{{ routes.search_url }}">Buscar</a>
          <a href="{{ routes.cart_url }}">Sacola</a>
        </div>
      </div>
      <div>
        <h3>Atendimento</h3>
        <div class="footer-links">
          {% if shop.email != blank %}<a href="mailto:{{ shop.email }}">{{ shop.email }}</a>{% endif %}
          {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Trocas e devoluções</a>{% endif %}
          {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Envios</a>{% endif %}
          {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Privacidade</a>{% endif %}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} Pure Essence & Co.</span>
      <span>Dubai → Brasil</span>
    </div>
  </div>
</footer>
{% schema %}{"name":"Footer","settings":[]}{% endschema %}