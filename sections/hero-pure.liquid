{% assign desktop_image = section.settings.image %}
{% assign mobile_image = section.settings.mobile_image %}
<section class="hero hero--image-only">
  {% if desktop_image != blank or mobile_image != blank %}
    {% if section.settings.link != blank %}<a class="hero-link" href="{{ section.settings.link }}">{% endif %}
      <picture class="hero-media">
        {% if mobile_image != blank %}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 1200 }}">
        {% endif %}
        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 2600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: shop.name }}
        {% else %}
          {{ mobile_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: shop.name }}
        {% endif %}
      </picture>
    {% if section.settings.link != blank %}</a>{% endif %}
  {% else %}
    <div class="hero-placeholder"><span>Adicione o banner da Pure Essence no editor do tema.</span></div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {"type":"image_picker","id":"image","label":"Banner desktop"},
    {"type":"image_picker","id":"mobile_image","label":"Banner mobile"},
    {"type":"url","id":"link","label":"Link do banner"}
  ],
  "presets": [{"name":"Hero banner"}]
}
{% endschema %}