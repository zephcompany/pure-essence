<section class="story" id="dubai-brasil">
  <div class="story-grid">
    <div class="story-media story-media--origin-art">
      <img src="{{ 'arte 3 dobra.png' | asset_url }}" alt="Pure Essence & Co · Dubai" width="1600" height="1600" loading="lazy">
    </div>

    <div class="story-copy">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading_before }} <span class="text-accent">{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_after }}</h2>
      <p>{{ section.settings.text }}</p>
      <p>{{ section.settings.text_2 }}</p>

      <div class="story-stats">
        <div><strong>Dubai</strong><span>Origem da inspiração</span></div>
        <div><strong>Brasil</strong><span>Onde a experiência continua</span></div>
        <div><strong>100 ml</strong><span>Em cada fragrância</span></div>
      </div>

      <div class="story-signature" dir="rtl">من دبي إلى البرازيل</div>
    </div>
  </div>
</section>

<style>
  .story-media--origin-art{
    background:#0b0b0b;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
  }
  .story-media--origin-art img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }
  @media(max-width:989px){
    .story-media--origin-art{
      min-height:0;
    }
    .story-media--origin-art img{
      width:100%;
      height:auto;
      object-fit:contain;
    }
  }
</style>

{% schema %}
{
  "name":"Dubai para o Brasil",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Texto pequeno","default":"NOSSA ORIGEM"},
    {"type":"text","id":"heading_before","label":"Título antes","default":"De"},
    {"type":"text","id":"heading_highlight","label":"Destaque","default":"Dubai"},
    {"type":"text","id":"heading_after","label":"Título depois","default":"para o Brasil."},
    {"type":"textarea","id":"text","label":"Texto 1","default":"Pure Essence & Co nasceu inspirada pela sofisticação de Dubai, onde tradição, modernidade e perfumaria se encontram de forma única."},
    {"type":"textarea","id":"text_2","label":"Texto 2","default":"Agora no Brasil, traduzimos essa origem em fragrâncias de 100 ml desenvolvidas com ingredientes selecionados e paixão genuína pela perfumaria de alta qualidade."}
  ],
  "presets":[{"name":"Dubai para o Brasil"}]
}
{% endschema %}