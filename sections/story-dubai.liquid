<section class="story" id="dubai-brasil"><div class="story-grid"><div class="story-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% endif %}</div><div class="story-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><p>{{ section.settings.text_2 }}</p><div class="story-signature" dir="rtl">من دبي إلى البرازيل</div></div></div></section>
{% schema %}
{"name":"Dubai para o Brasil","settings":[{"type":"text","id":"eyebrow","label":"Texto pequeno","default":"NOSSA ORIGEM"},{"type":"text","id":"heading","label":"Título","default":"De Dubai para o Brasil."},{"type":"textarea","id":"text","label":"Texto 1","default":"Pure Essence & Co nasceu inspirada pela sofisticação de Dubai, um lugar onde tradição, modernidade e perfumaria se encontram de forma única."},{"type":"textarea","id":"text_2","label":"Texto 2","default":"Agora no Brasil, traduzimos essa origem em fragrâncias de 100 ml desenvolvidas com ingredientes selecionados e uma paixão genuína pela perfumaria de alta qualidade."},{"type":"image_picker","id":"image","label":"Imagem da seção"}],"presets":[{"name":"Dubai para o Brasil"}]}
{% endschema %}