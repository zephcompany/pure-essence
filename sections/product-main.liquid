{% assign perfume_handles = 'paradox,only-bleu,swin,rouge,pacific,good,magination,erba,hyper,fine-miyake' | split: ',' %}

<section class="pe-product">
  <div class="page-width">
    <nav class="pe-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Início</a>
      <span>/</span>
      <a href="/collections/perfumes">Perfumes</a>
      <span>/</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="pe-product-hero">
      <div class="pe-product-thumbs" aria-label="Imagens do produto">
        {% for image in product.images %}
          <button class="pe-product-thumb{% if forloop.first %} is-active{% endif %}" type="button" data-product-thumb data-image-url="{{ image | image_url: width: 1400 }}" aria-label="Ver imagem {{ forloop.index }} de {{ product.title }}">
            {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}
          </button>
        {% endfor %}
      </div>

      <div class="pe-product-stage">
        <div class="pe-product-stage__badge">100 ML</div>
        {% if product.featured_image %}
          <img id="ProductMainImage-{{ section.id }}" src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1200" height="1500" loading="eager" fetchpriority="high">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <aside class="pe-product-buybox">
        <div class="pe-product-origin">PURE ESSENCE & CO · DUBAI → BRASIL</div>
        <h1>{{ product.title }}</h1>
        <div class="pe-product-subtitle">Perfume 100 ml</div>

        <div class="pe-product-pricing">
          {% if product.compare_at_price_max > product.price %}
            <span class="pe-product-compare">{{ product.compare_at_price_max | money }}</span>
          {% endif %}
          <strong>{{ product.price | money }}</strong>
          <span>ou 3x de {{ product.price | divided_by: 3 | money }} sem juros</span>
        </div>

        {% form 'product', product, class: 'pe-product-form' %}
          {% unless product.has_only_default_variant %}
            <label for="Variant-{{ section.id }}">Escolha uma opção</label>
            <select id="Variant-{{ section.id }}" name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} · Esgotado{% endunless %}</option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}

          <button class="pe-product-add" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            <span>{% if product.selected_or_first_available_variant.available %}Adicionar à sacola{% else %}Esgotado{% endif %}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5h11l1 11h-13l1-11Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 9V7a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>

          {% if product.selected_or_first_available_variant.available %}
            <div class="pe-product-buy-now">{{ form | payment_button }}</div>
          {% endif %}
        {% endform %}

        <div class="pe-product-trust">
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3V7Zm11 3h3l4 4v2h-7v-6Z" fill="none" stroke="currentColor" stroke-width="1.35"/><circle cx="7" cy="18" r="1.5" fill="none" stroke="currentColor" stroke-width="1.35"/><circle cx="17" cy="18" r="1.5" fill="none" stroke="currentColor" stroke-width="1.35"/></svg>
            <span><strong>Envio nacional</strong>Para todo o Brasil</span>
          </div>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.35"/><path d="M8.5 10V7.7a3.5 3.5 0 0 1 7 0V10" fill="none" stroke="currentColor" stroke-width="1.35"/></svg>
            <span><strong>Compra segura</strong>Checkout protegido</span>
          </div>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1.3 3.1 3.8 5.6 7 7-3.2 1.4-5.7 3.9-7 7-1.3-3.1-3.8-5.6-7-7 3.2-1.4 5.7-3.9 7-7Z" fill="none" stroke="currentColor" stroke-width="1.35"/></svg>
            <span><strong>Pure Essence</strong>Inspirada em Dubai</span>
          </div>
        </div>

        <div class="pe-product-details">
          <details open>
            <summary>Sobre a fragrância <span>+</span></summary>
            <div class="pe-product-description">
              {% if product.description != blank %}
                {{ product.description }}
              {% else %}
                <p>{{ product.title }} é uma fragrância Pure Essence & Co de 100 ml, criada para transformar presença em memória com uma assinatura sofisticada e marcante.</p>
              {% endif %}
            </div>
          </details>
          <details>
            <summary>Origem da marca <span>+</span></summary>
            <p>Inspirada pela sofisticação de Dubai e criada para o Brasil. Elegância, presença e perfumaria de alta qualidade em uma identidade própria.</p>
          </details>
          <details>
            <summary>Entrega e pagamento <span>+</span></summary>
            <p>Enviamos para todo o Brasil. Pagamento processado em ambiente seguro pela Shopify.</p>
          </details>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="pe-product-story">
  <div class="page-width pe-product-story__grid">
    <div>
      <div class="eyebrow">A ESSÊNCIA PURE</div>
      <h2>De <span class="text-accent">Dubai</span> para a sua presença.</h2>
    </div>
    <p>A Pure Essence & Co nasceu da inspiração pelo luxo autêntico de Dubai e chega ao Brasil com fragrâncias sofisticadas, feitas para acompanhar momentos e deixar memória.</p>
    <div class="pe-product-story__mark" aria-hidden="true">
      <img src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="" width="180" height="201" loading="lazy">
    </div>
  </div>
</section>

<section class="section pe-related">
  <div class="page-width">
    <div class="section-head">
      <div>
        <div class="eyebrow">DESCUBRA MAIS</div>
        <h2>Você também pode <span class="text-accent">gostar.</span></h2>
      </div>
      <a href="/collections/perfumes">Ver todos</a>
    </div>

    <div class="product-grid pe-related-grid">
      {% assign shown = 0 %}
      {% for handle in perfume_handles %}
        {% if shown >= 4 %}{% break %}{% endif %}
        {% assign related_product = all_products[handle] %}
        {% if related_product != blank and related_product.handle != product.handle %}
          {% render 'product-card', product: related_product %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.currentScript.closest('section')?.previousElementSibling?.previousElementSibling || document;
    const mainImage = document.getElementById('ProductMainImage-{{ section.id }}');
    const thumbs = document.querySelectorAll('[data-product-thumb]');
    if (!mainImage || !thumbs.length) return;
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const url = thumb.dataset.imageUrl;
        if (!url) return;
        mainImage.src = url;
        thumbs.forEach((item) => item.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}{"name":"Produto principal","settings":[]}{% endschema %}