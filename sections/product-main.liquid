<section class="pe-product">
  <div class="page-width">
    <nav class="pe-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <a href="/collections/perfumes">Perfumes</a>
      <span>/</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="pe-product-hero">
      <div class="pe-product-thumbs" aria-label="Imagens do produto">
        {% for image in product.images %}
          <button class="pe-product-thumb{% if forloop.first %} is-active{% endif %}" type="button" data-product-thumb data-image-url="{{ image | image_url: width: 1600 }}" aria-label="Ver imagem {{ forloop.index }} de {{ product.title }}">
            {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}
          </button>
        {% endfor %}
      </div>

      <div class="pe-product-stage">
        {% if product.compare_at_price_max > product.price %}
          {% assign saving = product.compare_at_price_max | minus: product.price %}
          {% assign discount = saving | times: 100.0 | divided_by: product.compare_at_price_max | round %}
          <div class="pe-product-stage__badge">{{ discount }}% OFF</div>
        {% else %}
          <div class="pe-product-stage__badge">100 ML</div>
        {% endif %}

        {% if product.featured_image %}
          <img id="ProductMainImage-{{ section.id }}" src="{{ product.featured_image | image_url: width: 1800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1400" height="1750" loading="eager" fetchpriority="high">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <aside class="pe-product-buybox">
        <div class="pe-product-origin">PURE ESSENCE & CO · DUBAI → BRASIL</div>
        <h1>{{ product.title }} <span>100 ml</span></h1>

        <div class="pe-product-pricing">
          {% if product.compare_at_price_max > product.price %}
            <span class="pe-product-compare">{{ product.compare_at_price_max | money }}</span>
          {% endif %}
          <div class="pe-product-price-line">
            <strong>{{ product.price | money }}</strong>
            {% if product.compare_at_price_max > product.price %}<em>{{ discount }}% OFF</em>{% endif %}
          </div>
          <span>3x de {{ product.price | divided_by: 3 | money }} sem juros</span>
        </div>

        <button class="pe-product-more" type="button" data-scroll-description>Ver mais detalhes ↓</button>

        {% form 'product', product, class: 'pe-product-form' %}
          {% unless product.has_only_default_variant %}
            <label for="Variant-{{ section.id }}">Escolha uma opção</label>
            <select id="Variant-{{ section.id }}" name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} · Esgotado{% endunless %}</option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endunless %}

          <div class="pe-product-purchase-row">
            <div class="pe-quantity" aria-label="Quantidade">
              <button type="button" data-qty-minus aria-label="Diminuir quantidade">−</button>
              <input type="number" name="quantity" min="1" value="1" inputmode="numeric" aria-label="Quantidade">
              <button type="button" data-qty-plus aria-label="Aumentar quantidade">+</button>
            </div>

            <button class="pe-product-add" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
              {% if product.selected_or_first_available_variant.available %}Comprar{% else %}Esgotado{% endif %}
            </button>
          </div>
        {% endform %}

        <div class="pe-shipping-box">
          <div class="pe-shipping-box__head">
            <strong>MEIOS DE ENVIO</strong>
            <span>+</span>
          </div>
          <div class="pe-shipping-box__notice">Envio para todo o Brasil</div>
          <p>Prazo e valor do frete são calculados no checkout após informar seu CEP.</p>
        </div>

        <div class="pe-product-mini-trust">
          <span>Compra segura</span>
          <span>100 ml</span>
          <span>Inspirada em Dubai</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="pe-product-description-section" id="ProductDescription-{{ section.id }}">
  <div class="page-width">
    <div class="pe-product-description-card">
      <div class="pe-product-description-card__head">
        <div>
          <div class="eyebrow">PURE ESSENCE · 100 ML</div>
          <h2>Descrição</h2>
        </div>
        <img src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="" width="120" height="134" loading="lazy">
      </div>

      <div class="pe-product-description-body">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p><strong>{{ product.title }}</strong> é uma fragrância Pure Essence & Co de 100 ml, criada para transformar presença em memória.</p>
          <p>Uma composição elegante e marcante, inspirada na sofisticação de Dubai e pensada para acompanhar momentos que merecem ser lembrados.</p>
        {% endif %}
      </div>

      <div class="pe-product-facts">
        <div><span>01</span><strong>Volume</strong><small>100 ml</small></div>
        <div><span>02</span><strong>Origem</strong><small>Dubai → Brasil</small></div>
        <div><span>03</span><strong>Marca</strong><small>Pure Essence & Co</small></div>
      </div>
    </div>
  </div>
</section>

<section class="pe-product-story">
  <div class="page-width pe-product-story__grid">
    <div>
      <div class="eyebrow">A ESSÊNCIA PURE</div>
      <h2>De <span class="text-accent">Dubai</span> para a sua presença.</h2>
    </div>
    <p>A Pure Essence & Co nasceu da inspiração pelo luxo autêntico de Dubai e chega ao Brasil com fragrâncias sofisticadas, feitas para acompanhar momentos e deixar memória.</p>
    <div class="pe-product-story__mark" aria-hidden="true">
      <img src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="" width="180" height="201" loading="lazy">
    </div>
  </div>
</section>

<section class="section pe-related">
  <div class="page-width">
    <div class="section-head">
      <div>
        <div class="eyebrow">DESCUBRA MAIS</div>
        <h2>Você também pode <span class="text-accent">gostar.</span></h2>
      </div>
      <a href="/collections/perfumes">Ver todos</a>
    </div>

    <div class="product-grid pe-related-grid">
      {% assign shown = 0 %}
      {% for related_product in collections['all'].products %}
        {% if shown >= 4 %}{% break %}{% endif %}
        {% if related_product.handle != product.handle %}
          {% if related_product.type == 'Perfume' or related_product.vendor == 'Pure Essence & Co' %}
            {% render 'product-card', product: related_product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const mainImage = document.getElementById('ProductMainImage-{{ section.id }}');
    const thumbs = document.querySelectorAll('[data-product-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const url = thumb.dataset.imageUrl;
        if (!mainImage || !url) return;
        mainImage.src = url;
        thumbs.forEach((item) => item.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });

    const qtyInput = document.querySelector('.pe-quantity input');
    document.querySelector('[data-qty-minus]')?.addEventListener('click', () => {
      if (!qtyInput) return;
      qtyInput.value = Math.max(1, Number(qtyInput.value || 1) - 1);
    });
    document.querySelector('[data-qty-plus]')?.addEventListener('click', () => {
      if (!qtyInput) return;
      qtyInput.value = Number(qtyInput.value || 1) + 1;
    });

    document.querySelector('[data-scroll-description]')?.addEventListener('click', () => {
      document.getElementById('ProductDescription-{{ section.id }}')?.scrollIntoView({behavior:'smooth', block:'start'});
    });
  })();
</script>

{% schema %}{"name":"Produto principal","settings":[]}{% endschema %}