<section class="product-page"><div class="page-width product-layout"><div class="product-gallery">{% for image in product.images %}<div class="product-gallery__item">{{ image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}</div>{% else %}<div class="product-gallery__item">{{ 'product-1' | placeholder_svg_tag }}</div>{% endfor %}</div><div class="product-info"><div class="vendor">{{ product.vendor | default: 'Pure Essence & Co' }}</div><h1>{{ product.title }}</h1><div class="product-price">{{ product.price | money }}</div><div class="installments">ou 3x de {{ product.price | divided_by: 3 | money }} sem juros</div>{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">Escolha uma opção</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} · Esgotado{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<button class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Adicionar à sacola{% else %}Esgotado{% endif %}</button>{% endform %}<div class="product-notes"><div class="product-note"><strong>Volume</strong><span>100 ml</span></div><div class="product-note"><strong>Origem da marca</strong><span>Dubai</span></div><div class="product-note"><strong>Categoria</strong><span>Perfume</span></div></div><div class="product-description">{{ product.description }}</div><div class="trust-row"><div class="trust-item"><strong>Alta perfumaria</strong><br>Fragrâncias selecionadas</div><div class="trust-item"><strong>Dubai → Brasil</strong><br>Identidade internacional</div><div class="trust-item"><strong>Compra segura</strong><br>Checkout Shopify</div></div></div></div></section>
{% schema %}{"name":"Produto principal","settings":[]}{% endschema %}