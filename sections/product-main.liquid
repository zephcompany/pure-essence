{% assign is_body_splash = false %}
{% if product.type == 'Body Splash' or product.tags contains 'Body Splash' %}{% assign is_body_splash = true %}{% endif %}
{% assign is_perfume = false %}
{% if product.type == 'Perfume' %}{% assign is_perfume = true %}{% endif %}

{% assign base_handle = product.handle %}
{% assign matching_pair = blank %}
{% assign matching_combo = blank %}
{% assign matching_pair_type = '' %}
{% assign bundle_heading = '' %}

{% if is_body_splash %}
  {% assign base_handle = product.handle | replace: '-body-splash', '' %}
  {% assign perfume_handle = base_handle %}
  {% assign combo_handle = base_handle | append: '-combo' %}
  {% assign matching_pair = all_products[perfume_handle] %}
  {% assign matching_combo = all_products[combo_handle] %}
  {% assign matching_pair_type = 'Perfume' %}
  {% assign bundle_heading = 'Leve o Perfume junto' %}
{% elsif is_perfume %}
  {% assign splash_handle = base_handle | append: '-body-splash' %}
  {% assign combo_handle = base_handle | append: '-combo' %}
  {% assign matching_pair = all_products[splash_handle] %}
  {% assign matching_combo = all_products[combo_handle] %}
  {% assign matching_pair_type = 'Body Splash' %}
  {% assign bundle_heading = 'Leve o Body Splash junto' %}
{% endif %}

<section class="pe-product">
  <div class="page-width">
    <nav class="pe-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span>/</span>
      {% if is_body_splash %}<a href="/collections/body-splash">Body Splash</a>{% else %}<a href="/collections/perfumes">Perfumes</a>{% endif %}
      <span>/</span><span>{{ product.title }}</span>
    </nav>

    <div class="pe-product-hero">
      <div class="pe-product-thumbs" aria-label="Imagens do produto">
        {% for image in product.images %}
          <button class="pe-product-thumb{% if forloop.first %} is-active{% endif %}" type="button" data-product-thumb data-image-url="{{ image | image_url: width: 1600 }}" aria-label="Ver imagem {{ forloop.index }} de {{ product.title }}">{{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}</button>
        {% endfor %}
      </div>

      <div class="pe-product-stage">
        {% if product.compare_at_price_max > product.price %}
          {% assign saving = product.compare_at_price_max | minus: product.price %}{% assign discount = saving | times: 100.0 | divided_by: product.compare_at_price_max | round %}
          <div class="pe-product-stage__badge">{{ discount }}% OFF</div>
        {% else %}<div class="pe-product-stage__badge">{% if is_body_splash %}BODY SPLASH{% else %}100 ML{% endif %}</div>{% endif %}
        {% if product.featured_image %}<img id="ProductMainImage-{{ section.id }}" src="{{ product.featured_image | image_url: width: 1800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1400" height="1750" loading="eager" fetchpriority="high">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
      </div>

      <aside class="pe-product-buybox">
        <div class="pe-product-origin">PURE ESSENCE & CO · {% if is_body_splash %}BODY SPLASH · {% endif %}DUBAI → BRASIL</div>
        <h1>{{ product.title }} <span>100 ml</span></h1>
        <div class="pe-product-pricing">
          {% if product.compare_at_price_max > product.price %}<span class="pe-product-compare">{{ product.compare_at_price_max | money }}</span>{% endif %}
          <div class="pe-product-price-line"><strong>{{ product.price | money }}</strong>{% if product.compare_at_price_max > product.price %}<em>{{ discount }}% OFF</em>{% endif %}</div>
          <span>3x de {{ product.price | divided_by: 3 | money }} sem juros</span>
        </div>
        <button class="pe-product-more" type="button" data-scroll-description>Ver mais detalhes ↓</button>

        {% form 'product', product, class: 'pe-product-form' %}
          {% unless product.has_only_default_variant %}<label for="Variant-{{ section.id }}">Escolha uma opção</label><select id="Variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} · Esgotado{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
          <div class="pe-product-purchase-row">
            <div class="pe-quantity" aria-label="Quantidade"><button type="button" data-qty-minus aria-label="Diminuir quantidade">−</button><input type="number" name="quantity" min="1" value="1" inputmode="numeric" aria-label="Quantidade"><button type="button" data-qty-plus aria-label="Aumentar quantidade">+</button></div>
            <button class="pe-product-add" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Comprar{% else %}Esgotado{% endif %}</button>
          </div>
        {% endform %}

        <div class="pe-shipping-box"><div class="pe-shipping-box__head"><strong>MEIOS DE ENVIO</strong><span>+</span></div><div class="pe-shipping-box__notice">Envio para todo o Brasil</div><p>Prazo e valor do frete são calculados no checkout após informar seu CEP.</p></div>
        <div class="pe-product-mini-trust"><span>Compra segura</span><span>100 ml</span><span>Inspirada em Dubai</span></div>

        {% if matching_pair != blank and matching_combo != blank %}
          <div class="pe-mini-bundle-fixed" style="margin-top:18px;padding:16px;border:1px solid rgba(178,138,74,.32);background:#f7f2e8;border-radius:14px;box-sizing:border-box;width:100%;overflow:hidden;">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px;">
              <div style="min-width:0;">
                <span style="display:inline-flex;align-items:center;justify-content:center;padding:5px 8px;border-radius:999px;background:#111;color:#fff;font-size:7px;line-height:1;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px;">PROMOÇÃO</span>
                <h3 style="margin:0 0 5px;font-family:Georgia,'Times New Roman',serif;font-size:20px;line-height:1.05;font-weight:400;letter-spacing:-.03em;color:#111;">{{ bundle_heading }}</h3>
                <p style="margin:0;font-size:9px;line-height:1.5;color:#6f685f;max-width:360px;">Complete a mesma fragrância com o {{ matching_pair_type }} correspondente e leve o duo Pure Essence por um valor especial.</p>
              </div>
              <span style="flex:0 0 auto;font-size:7px;letter-spacing:.09em;text-transform:uppercase;color:#8a6a2f;border:1px solid rgba(178,138,74,.32);padding:5px 7px;border-radius:999px;">COMBO</span>
            </div>

            <div style="display:grid;grid-template-columns:78px minmax(0,1fr);gap:12px;align-items:center;padding:12px 0;border-top:1px solid rgba(17,17,17,.08);border-bottom:1px solid rgba(17,17,17,.08);">
              <a href="{{ matching_pair.url }}" style="display:block;width:78px;height:78px;border-radius:10px;overflow:hidden;background:#fff;text-decoration:none;">
                {% if matching_pair.featured_image %}
                  <img src="{{ matching_pair.featured_image | image_url: width: 240 }}" alt="{{ matching_pair.title | escape }}" loading="lazy" width="78" height="78" style="display:block!important;width:78px!important;height:78px!important;max-width:78px!important;min-width:78px!important;object-fit:cover!important;object-position:center!important;margin:0!important;border-radius:10px!important;">
                {% endif %}
              </a>

              <div style="min-width:0;display:flex;flex-direction:column;align-items:flex-start;">
                <a href="{{ matching_pair.url }}" style="display:block;margin:0 0 3px;color:#111;text-decoration:none;font-size:11px;line-height:1.25;font-weight:700;">{{ matching_pair.title }}</a>
                <span style="font-size:8px;line-height:1.35;color:#777067;">{{ matching_pair_type }} · 100 ml</span>
                <div style="display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-top:7px;">
                  <s style="font-size:9px;color:#918981;">R$ 139,80</s>
                  <strong style="font-size:20px;line-height:1;color:#111;">{{ matching_combo.price | money }}</strong>
                </div>
                <span style="display:block;margin-top:5px;font-size:7px;line-height:1.2;letter-spacing:.08em;text-transform:uppercase;color:#8a6a2f;font-weight:700;">Economize R$ 19,80</span>
              </div>
            </div>

            <button type="button" data-bundle-add data-bundle-variant="{{ matching_combo.selected_or_first_available_variant.id }}" {% unless matching_combo.selected_or_first_available_variant.available %}disabled{% endunless %} style="appearance:none;-webkit-appearance:none;width:100%;min-height:46px;margin-top:12px;border:1px solid #111;border-radius:10px;background:#111;color:#fff;padding:0 13px;display:flex;align-items:center;justify-content:space-between;gap:10px;text-transform:uppercase;font-family:inherit;font-size:8px;line-height:1;letter-spacing:.1em;cursor:pointer;box-sizing:border-box;">
              <span>{% if matching_combo.selected_or_first_available_variant.available %}Levar Perfume + Body Splash{% else %}Combo indisponível{% endif %}</span><span>→</span>
            </button>
            <small style="display:block;margin-top:7px;font-size:7px;line-height:1.4;color:#8a8178;">1 Perfume 100 ml + 1 Body Splash 100 ml da mesma fragrância.</small>
          </div>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

<style>
  .pe-mini-bundle-fixed img{width:78px!important;height:78px!important;max-width:78px!important;min-width:78px!important;object-fit:cover!important}
  .pe-mini-bundle-fixed button{font:inherit}
  @media(max-width:749px){
    .pe-mini-bundle-fixed{margin-top:16px!important;padding:14px!important;border-radius:12px!important}
    .pe-mini-bundle-fixed img{width:70px!important;height:70px!important;max-width:70px!important;min-width:70px!important}
    .pe-mini-bundle-fixed a[style*="width:78px"]{width:70px!important;height:70px!important}
    .pe-mini-bundle-fixed div[style*="grid-template-columns:78px"]{grid-template-columns:70px minmax(0,1fr)!important;gap:10px!important}
    .pe-mini-bundle-fixed h3{font-size:18px!important}
  }
</style>

<section class="pe-product-description-section" id="ProductDescription-{{ section.id }}"><div class="page-width"><div class="pe-product-description-card"><div class="pe-product-description-card__head"><div><div class="eyebrow">PURE ESSENCE · {% if is_body_splash %}BODY SPLASH{% else %}PERFUME{% endif %} · 100 ML</div><h2>{% if is_body_splash %}Conheça o Body Splash{% else %}Conheça a fragrância{% endif %}</h2></div><img src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="" width="120" height="134" loading="lazy"></div><div class="pe-product-description-body">{% if is_body_splash %}{% if product.description != blank %}{{ product.description }}{% else %}<p><strong>{{ product.title }}</strong> é a versão Body Splash da fragrância Pure Essence, criada para uma perfumação mais leve e versátil ao longo do dia.</p><p>Use sozinho ou em conjunto com o perfume correspondente para criar um ritual completo de fragrância.</p>{% endif %}{% else %}{% render 'product-olfactory-profile', product: product %}{% endif %}</div><div class="pe-product-facts"><div><span>01</span><strong>Volume</strong><small>100 ml</small></div><div><span>02</span><strong>Tipo</strong><small>{% if is_body_splash %}Body Splash{% else %}Perfume{% endif %}</small></div><div><span>03</span><strong>Origem</strong><small>Dubai → Brasil</small></div></div></div></div></section>

<section class="pe-product-story"><div class="page-width pe-product-story__grid"><div><div class="eyebrow">A ESSÊNCIA PURE</div><h2>De <span class="text-accent">Dubai</span> para a sua presença.</h2></div><p>A Pure Essence & Co nasceu da inspiração pelo luxo autêntico de Dubai e chega ao Brasil com perfumes e Body Splashes sofisticados, feitos para acompanhar momentos e deixar memória.</p><div class="pe-product-story__mark" aria-hidden="true"><img src="{{ 'pure-essence-mark.webp' | asset_url }}" alt="" width="180" height="201" loading="lazy"></div></div></section>

<section class="section pe-related"><div class="page-width"><div class="section-head"><div><div class="eyebrow">DESCUBRA MAIS</div><h2>Você também pode <span class="text-accent">gostar.</span></h2></div><a href="{% if is_body_splash %}/collections/body-splash{% else %}/collections/perfumes{% endif %}">Ver todos</a></div><div class="product-grid pe-related-grid">{% assign shown = 0 %}{% for related_product in collections['all'].products %}{% if shown >= 4 %}{% break %}{% endif %}{% if related_product.handle != product.handle %}{% if is_body_splash %}{% if related_product.type == 'Body Splash' or related_product.tags contains 'Body Splash' %}{% render 'product-card', product: related_product %}{% assign shown = shown | plus: 1 %}{% endif %}{% else %}{% if related_product.type == 'Perfume' %}{% render 'product-card', product: related_product %}{% assign shown = shown | plus: 1 %}{% endif %}{% endif %}{% endif %}{% endfor %}</div></div></section>

<section class="pe-faq"><div class="page-width pe-faq__wrap"><div class="pe-faq__intro"><div class="eyebrow">DÚVIDAS SOBRE A PURE</div><h2>Perguntas <span class="text-accent">Frequentes.</span></h2><p>O essencial antes de escolher sua fragrância.</p></div><div class="pe-faq__list"><details open><summary><span>01</span><strong>As fragrâncias da Pure Essence têm boa performance?</strong><b>+</b></summary><div class="pe-faq__answer">Sim. Os perfumes Pure Essence são desenvolvidos para boa presença e duração, enquanto os Body Splashes oferecem uma perfumação propositalmente mais leve, ideal para reaplicação ao longo do dia. A performance pode variar de acordo com pele, clima e quantidade aplicada.</div></details><details><summary><span>02</span><strong>Posso receber uma amostra antes de comprar?</strong><b>+</b></summary><div class="pe-faq__answer">No momento, não trabalhamos com envio de amostras antes da compra. Para ajudar na escolha, as páginas dos perfumes apresentam perfil olfativo, notas e ocasiões de uso. Consulte também a política vigente de trocas e devoluções da Pure Essence & Co.</div></details><details><summary><span>03</span><strong>Posso confiar na Pure Essence? Minha compra vai chegar?</strong><b>+</b></summary><div class="pe-faq__answer">A Pure Essence & Co nasce da inspiração pela sofisticação de Dubai e chega ao Brasil com uma experiência de compra realizada pelo site oficial, checkout protegido pela Shopify e acompanhamento do pedido após a confirmação.</div></details></div></div></section>

<script>(()=>{const mainImage=document.getElementById('ProductMainImage-{{ section.id }}');const thumbs=document.querySelectorAll('[data-product-thumb]');thumbs.forEach((thumb)=>{thumb.addEventListener('click',()=>{const url=thumb.dataset.imageUrl;if(!mainImage||!url)return;mainImage.src=url;thumbs.forEach((item)=>item.classList.remove('is-active'));thumb.classList.add('is-active')})});const qtyInput=document.querySelector('.pe-quantity input');document.querySelector('[data-qty-minus]')?.addEventListener('click',()=>{if(!qtyInput)return;qtyInput.value=Math.max(1,Number(qtyInput.value||1)-1)});document.querySelector('[data-qty-plus]')?.addEventListener('click',()=>{if(!qtyInput)return;qtyInput.value=Number(qtyInput.value||1)+1});document.querySelector('[data-scroll-description]')?.addEventListener('click',()=>{document.getElementById('ProductDescription-{{ section.id }}')?.scrollIntoView({behavior:'smooth',block:'start'})});document.querySelector('[data-bundle-add]')?.addEventListener('click',async(event)=>{const button=event.currentTarget;const bundleVariant=Number(button.dataset.bundleVariant);if(!bundleVariant)return;const original=button.innerHTML;button.disabled=true;button.innerHTML='<span>Adicionando...</span>';try{const response=await fetch('{{ routes.cart_add_url }}.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:bundleVariant,quantity:1}]})});if(!response.ok)throw new Error('bundle-add');window.location.href='{{ routes.cart_url }}'}catch(error){button.disabled=false;button.innerHTML=original;alert('Não foi possível adicionar o combo. Tente novamente.')}})})();</script>

{% schema %}{"name":"Produto principal","settings":[]}{% endschema %}