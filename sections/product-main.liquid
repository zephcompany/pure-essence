<section class="product-page">
  <div class="page-width product-layout">
    <div class="product-gallery">
      {% for image in product.images %}
        <div class="product-gallery__item">
          {{ image | image_url: width: 1500 | image_tag: loading: 'lazy', alt: product.title }}
        </div>
      {% else %}
        <div class="product-gallery__item">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endfor %}
    </div>

    <div class="product-info">
      <div class="product-kicker"><span>PURE ESSENCE & CO</span><span>DUBAI → BRASIL</span></div>
      <div class="vendor">{{ product.vendor | default: 'Pure Essence & Co' }}</div>
      <h1>{{ product.title }}</h1>
      <div class="product-price">{{ product.price | money }}</div>
      <div class="installments">Perfume · 100 ml · compra segura via Shopify</div>

      {% form 'product', product, class: 'product-form' %}
        {% unless product.has_only_default_variant %}
          <label for="Variant-{{ section.id }}">Escolha uma opção</label>
          <select id="Variant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} · Esgotado{% endunless %}</option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}
        <button class="button product-add" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <span>{% if product.selected_or_first_available_variant.available %}Adicionar à sacola{% else %}Esgotado{% endif %}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5h11l1 11h-13l1-11Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 9V7a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
      {% endform %}

      <div class="product-notes product-notes--icons">
        <div class="product-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6v3.5l2 2V20H7V8.5l2-2V3Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><strong>Volume</strong><span>100 ml</span></div>
        <div class="product-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><strong>Origem</strong><span>Dubai</span></div>
        <div class="product-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1.3 3.1 3.8 5.6 7 7-3.2 1.4-5.7 3.9-7 7-1.3-3.1-3.8-5.6-7-7 3.2-1.4 5.7-3.9 7-7Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><strong>Linha</strong><span>Pure Essence</span></div>
      </div>

      <div class="product-accordions">
        <details open><summary>Sobre a fragrância <span>+</span></summary><div class="product-description">{{ product.description }}</div></details>
        <details><summary>Origem Pure Essence <span>+</span></summary><p>Nascida sob a inspiração da sofisticação de Dubai, a Pure Essence & Co chega ao Brasil unindo elegância, presença e uma paixão genuína pela perfumaria.</p></details>
        <details><summary>Envio e segurança <span>+</span></summary><p>Enviamos para todo o Brasil. O pagamento é processado em ambiente protegido pela Shopify.</p></details>
      </div>

      <div class="trust-row trust-row--icons">
        <div class="trust-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3V7Zm11 3h3l4 4v2h-7v-6Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><div><strong>Envio nacional</strong><br>Para todo o Brasil</div></div>
        <div class="trust-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="5" y="10" width="14" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><div><strong>Compra segura</strong><br>Checkout Shopify</div></div>
        <div class="trust-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1.3 3.1 3.8 5.6 7 7-3.2 1.4-5.7 3.9-7 7-1.3-3.1-3.8-5.6-7-7 3.2-1.4 5.7-3.9 7-7Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><div><strong>Essência premium</strong><br>Identidade Dubai → Brasil</div></div>
      </div>
    </div>
  </div>
</section>
{% schema %}{"name":"Produto principal","settings":[]}{% endschema %}