<article class="product-card"><a href="{{ product.url }}"><div class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><div class="product-card__meta"><div class="product-card__brand">Pure Essence & Co</div><h3 class="product-card__title">{{ product.title }}</h3><div class="product-card__price">{{ product.price | money }}</div><div class="product-card__volume">Perfume · 100 ml</div></div></a></article>