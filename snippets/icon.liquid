{% assign icon_name = name | default: 'sparkles' %}
<span class="icon icon--{{ icon_name }}" aria-hidden="true">
  {% case icon_name %}
    {% when 'menu' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'close' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    {% when 'search' %}
      <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    {% when 'bag' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="M6.5 8.5h11l1 11h-13l1-11Z" stroke="currentColor" stroke-width="1.5"/><path d="M9 9V6.8a3 3 0 0 1 6 0V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    {% when 'sparkles' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5c.7 3.4 2.6 5.3 6 6-3.4.7-5.3 2.6-6 6-.7-3.4-2.6-5.3-6-6 3.4-.7 5.3-2.6 6-6Z" stroke="currentColor" stroke-width="1.35"/><path d="M18.2 14.5c.35 1.7 1.3 2.65 3 3-1.7.35-2.65 1.3-3 3-.35-1.7-1.3-2.65-3-3 1.7-.35 2.65-1.3 3-3Z" stroke="currentColor" stroke-width="1.2"/></svg>
    {% when 'drop' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11Z" stroke="currentColor" stroke-width="1.45"/><path d="M9.2 15.2c.3 1.3 1.15 2.1 2.45 2.35" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
    {% when 'globe' %}
      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/><path d="M3.8 12h16.4M12 3.5c2 2.25 3 5.1 3 8.5s-1 6.25-3 8.5c-2-2.25-3-5.1-3-8.5s1-6.25 3-8.5Z" stroke="currentColor" stroke-width="1.25"/></svg>
    {% when 'plane' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="m3.5 13 7.2 1.6 6.9 5.4 1.1-.5-3-6.5 4.9-2.5c1.1-.55 1.4-1.75.85-2.5-.55-.75-1.65-.8-2.7-.2l-5 2.8-6.2-3.7-1.15.6 3.55 5.5-6.45-1.2V13Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
    {% when 'lock' %}
      <svg viewBox="0 0 24 24" fill="none"><rect x="5.5" y="10" width="13" height="10" rx="2" stroke="currentColor" stroke-width="1.45"/><path d="M8.5 10V7.7a3.5 3.5 0 0 1 7 0V10M12 14v2.5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/></svg>
    {% when 'diamond' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="m4 9 4-5h8l4 5-8 11L4 9Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/><path d="M4 9h16M8 4l4 5 4-5M8 9l4 11 4-11" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round"/></svg>
    {% when 'box' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="m4 8 8-4 8 4v9l-8 4-8-4V8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="m4 8 8 4 8-4M12 12v9" stroke="currentColor" stroke-width="1.25"/></svg>
    {% when 'arrow' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% when 'mail' %}
      <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="m5 8 7 5 7-5" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/></svg>
    {% when 'instagram' %}
      <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.45"/><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.45"/><circle cx="17.2" cy="6.8" r=".8" fill="currentColor"/></svg>
    {% when 'whatsapp' %}
      <svg viewBox="0 0 24 24" fill="none"><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.35-4A8 8 0 1 1 20 11.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.2c.3-.55.6-.55.95-.55.2 0 .45 0 .65.5l.8 1.85c.1.25.05.45-.1.65l-.6.75c-.15.2-.1.4 0 .55.55.95 1.35 1.75 2.35 2.25.2.1.4.1.55-.05l.75-.9c.2-.25.4-.2.65-.1l1.65.8c.3.15.35.35.3.6-.1.7-.65 1.4-1.3 1.75-.55.3-1.4.45-2.9-.2-1.8-.8-3.2-2.15-4.15-3.8-.8-1.4-.85-2.55-.4-3.55.2-.3.45-.5.8-.55Z" fill="currentColor"/></svg>
  {% endcase %}
</span>